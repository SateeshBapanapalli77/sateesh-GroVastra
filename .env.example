# ==============================================================================
# GroVastra Auto Campaigns - Environment Variables
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port
PORT=4000

# MongoDB Configuration
# NOTE: Must be a replica set (single-node rs0 is standard for local dev) to support transactions.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=grovastra_dev
MONGODB_TEST_DB=grovastra_test

# Dispatch Mode: 'dry' (safe dry-run / stubbed provider) or 'meta' (real WhatsApp API calls)
# Default is 'dry'
DISPATCH_MODE=dry

# Dev-only flag: allows UTILITY test templates (e.g. hello_world) to be used for MARKETING campaigns
ALLOW_TEST_CATEGORY_MISMATCH=true

# Meta WhatsApp Cloud API Credentials (optional for skeleton / dry run)
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Meta Test Allowlist: comma-separated list of verified E.164 phone numbers (max 5)
META_TEST_ALLOWLIST=

# Live Customer Phones: comma-separated list for production/live checks
LIVE_CUSTOMER_PHONES=

# Cryptographic Keys (optional for initial skeleton, required for phone encryption & sessions)
# ENCRYPTION_KEY: 32-byte hex string (64 characters)
ENCRYPTION_KEY=
SESSION_SECRET=

# Dev-only Clock Offset in milliseconds (positive or negative to simulate time travel)
# Ignored and disabled when NODE_ENV=production
DEV_TIME_OFFSET_MS=0
